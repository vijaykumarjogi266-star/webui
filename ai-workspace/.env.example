# AI Workspace — runtime environment template.
# Copy to .env for local/compose use (`.env` is git-ignored). PaaS dashboards
# and the systemd EnvironmentFile should set the same names directly.
#
# Truthfulness note: this build reads exactly ONE variable — PORT. Everything
# else below is either consumed by the deploy layer (compose/systemd/nginx)
# or a documented production-plan placeholder (build plan §32) that this
# zero-dependency build intentionally does not implement yet.

# ---- read by server.js ------------------------------------------------------
# Listen port / bind address.
PORT=3000
HOST=0.0.0.0

# --- security (see SECURITY.md) ---
# Shared access token gating every /api route. If unset, the server generates
# data/app.token (0600) on first boot and prints it once.
# APP_TOKEN=change-me-to-a-long-random-string
# Disable the auth gate entirely (ONLY for a trusted loopback dev box).
# AUTH_DISABLED=false
# Extra browser origins allowed to make state-changing calls (CSRF allowlist).
# ALLOWED_ORIGINS=https://ai.example.com
# Honour X-Forwarded-For for rate limiting. Set true ONLY behind a trusted proxy.
# TRUST_PROXY=false
# Always send HSTS (set true when TLS terminates upstream).
# FORCE_HSTS=false
# Allow this app to be embedded in an iframe by the listed parents (CSP
# frame-ancestors). Needed by hosted preview environments — e2b, Codespaces,
# Gitpod — which render the app in a frame. Default is 'none' (no embedding).
# Setting '*' disables clickjacking protection; the value is logged at boot.
# FRAME_ANCESTORS=https://*.e2b.app
# 64-hex master key for the credential vault. Preferred over data/master.key.
# MASTER_KEY=
# Allow outbound requests to private/link-local addresses. Keep OFF: this is the
# SSRF guard that blocks 169.254.169.254 (cloud metadata) and internal services.
# ALLOW_PRIVATE_EGRESS=false
# Upload / streaming limits.
# MAX_FILE_BYTES=20971520
# MAX_STREAM_CHARS=2097152

# ---- read by the deploy layer (compose / Make-free tooling) -----------------
NODE_ENV=production
# Host port published by docker-compose.yml (container port stays 3000).
PUBLISHED_PORT=3000
# Image tag applied by `npm run docker:build`.
IMAGE=ai-workspace:local
# Passed as a build arg so the image carries provenance labels.
GIT_SHA=unknown

# ---- NOT read by this build (production-plan placeholders, §13/§25/§32/§33) --
# MASTER_KEY_FILE=...        # demo build auto-generates ./data/master.key (0600)
# DATABASE_URL=...           # plan §9: Postgres replaces the JSON store
# REDIS_URL=...              # plan §12: queue/cache
# STORAGE_PROVIDER=local     # plan §22: OCI Object Storage / MinIO adapter
# LOG_JSON=1                 # plan §33: pino JSON logs
# ENABLE_CUSTOM_PROVIDERS=1  # plan §32 flag (custom base URL is always on here)
# ENABLE_GITHUB_WRITE_ACTIONS=false  # connector is read-only/public-only (§21)
