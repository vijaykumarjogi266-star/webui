# EnvironmentFile consumed by deploy/systemd/ai-workspace.service
# Install to /etc/ai-workspace/ai-workspace.env  (chown root:aiws, chmod 0640)
# systemd unit syntax: KEY=value, no export, no quotes needed.
#
# server.js reads only PORT. Put anything secret here ONLY if the box is
# LUKS/instance-store encrypted; the app's real secrets (provider API keys) live
# encrypted in the JSON store, keyed by data/master.key — back that file up.

NODE_ENV=production
PORT=3000
