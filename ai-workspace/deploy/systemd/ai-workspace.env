# EnvironmentFile consumed by deploy/systemd/ai-workspace.service
# Install to /etc/ai-workspace/ai-workspace.env  (chown root:aiws, chmod 0640)
# systemd unit syntax: KEY=value, no export, no quotes needed.
#
# This file holds the app's access token. Keep it 0640 root:aiws, and put it on
# an encrypted volume. Provider API keys live encrypted in the JSON store, keyed
# by MASTER_KEY (or data/master.key if unset) — back that up separately.

NODE_ENV=production
PORT=3000

# --- REQUIRED ---
# Gates every /api route. Without it the server generates a new token on each
# boot and prints it to the journal, so a restart locks users out.
#   openssl rand -base64 32
APP_TOKEN=CHANGE_ME_openssl_rand_base64_32

# --- Strongly recommended behind nginx (deploy/nginx/ai-workspace.conf) ---
# nginx sets X-Forwarded-For/Proto. Without TRUST_PROXY the app rate-limits on
# the proxy's IP, so every user shares one bucket and one abuser blocks all.
TRUST_PROXY=true
FORCE_HSTS=true

# --- Optional ---
# 64-hex credential-vault key. Preferred over data/master.key: keeps the key
# out of the same directory as the ciphertext it protects.
#   openssl rand -hex 32
# MASTER_KEY=
# Extra browser origins allowed to make state-changing calls.
# ALLOWED_ORIGINS=https://ai.example.com
# Allow iframe embedding (default: denied entirely).
# FRAME_ANCESTORS=
# Upload ceiling in bytes (default 20 MB). Keep in step with nginx
# client_max_body_size below.
# MAX_FILE_BYTES=20971520
